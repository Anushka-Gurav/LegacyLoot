PORT=8787
FRONTEND_ORIGIN=http://localhost:5173
MONAD_CHAIN_ID=10143
CONTRACT_ADDRESS=PASTE_NEW_DEPLOYED_CONTRACT_ADDRESS
# Private key for a dedicated claim-signing wallet; NEVER the deployer wallet unless deliberately chosen.
